# =============================================================================
# AutoTransport — master ignore file
# =============================================================================
#
# One file for the whole monorepo, replacing backend/.gitignore and
# mobile/.gitignore.
#
# TWO THINGS TO KNOW BEFORE EDITING THIS FILE
#
# 1. PATHS ARE RE-ANCHORED, NOT COPIED.
#    A leading slash anchors a pattern to the directory holding the .gitignore.
#    In backend/.gitignore, `/vendor` meant `backend/vendor`. Moved here
#    verbatim it would mean `AutoTransport/vendor`, which does not exist — so
#    Composer's 40 MB vendor tree would start showing up as untracked. Every
#    anchored rule below therefore names its subdirectory explicitly.
#
#    Patterns with NO leading slash (`node_modules/`, `.DS_Store`) match at any
#    depth and are safe to write once.
#
# 2. THE .gitignore FILES UNDER backend/storage AND backend/bootstrap/cache
#    ARE NOT IGNORE RULES — DO NOT DELETE THEM.
#    Each contains `*` plus `!.gitignore`, which is the standard trick for
#    committing an EMPTY directory: Git tracks files, not folders, so a
#    directory with no tracked file in it does not survive a clone. Those files
#    are the only reason `storage/framework/views/` exists after
#    `git clone`. Remove them and the app boots, then dies on the first page
#    render with "failed to open stream: No such file or directory" — a failure
#    that appears only on a fresh checkout and never on the machine that broke
#    it. They are load-bearing scaffolding, not configuration.
#
# =============================================================================


# --- Secrets and local configuration -----------------------------------------
# .env holds APP_KEY, database credentials and ADMIN_PASSWORD. A committed
# password is a published password, including in a private repo.
.env
.env.*
!.env.example
.env.backup
.env.production
auth.json
backend/storage/*.key


# --- Dependencies ------------------------------------------------------------
# Unanchored: catches backend/vendor, mobile/node_modules and any future package.
node_modules/
/backend/vendor/


# --- Laravel build output and runtime state ----------------------------------
/backend/public/build/
/backend/public/hot
/backend/public/storage
/backend/storage/pail
/backend/storage/logs/*.log
/backend/storage/framework/cache/data/*
/backend/storage/framework/sessions/*
/backend/storage/framework/testing/*
/backend/storage/framework/views/*
/backend/bootstrap/cache/*
# ...but keep the directory markers described in note 2 above.
!/backend/storage/framework/**/.gitignore
!/backend/bootstrap/cache/.gitignore

# Framework files generated by `artisan optimize` / `down`. Folded in from the
# old backend/storage/framework/.gitignore, which held nothing but these rules.
/backend/storage/framework/compiled.php
/backend/storage/framework/config.php
/backend/storage/framework/down
/backend/storage/framework/events.scanned.php
/backend/storage/framework/maintenance.php
/backend/storage/framework/routes.php
/backend/storage/framework/routes.scanned.php
/backend/storage/framework/schedule-*
/backend/storage/framework/services.json


# --- Local database ----------------------------------------------------------
# The dev database is SQLite and lives in the tree. It contains seeded demo
# people with plausible names, addresses and phone numbers; committing it turns
# fixture data into a permanent part of history.
*.sqlite
*.sqlite-journal
*.sqlite3


# --- Expo / React Native -----------------------------------------------------
/mobile/.expo/
/mobile/dist/
/mobile/web-build/
# Generated by the Expo CLI on install; regenerated, never hand-edited.
/mobile/expo-env.d.ts
# Prebuild output. These are generated from app.json and regenerating them is
# the supported workflow — committing them means every native change has two
# sources of truth that silently diverge.
/mobile/ios/
/mobile/android/
/mobile/.kotlin/
.metro-health-check*


# --- Signing material --------------------------------------------------------
# Leaking any of these lets someone ship an update as you.
*.jks
*.p8
*.p12
*.key
*.pem
*.mobileprovision
*.orig.*


# --- Test and tooling caches -------------------------------------------------
/backend/.phpunit.cache/
.phpunit.result.cache
.phpactor.json
*.tsbuildinfo
coverage/


# --- Logs --------------------------------------------------------------------
*.log
npm-debug.*
yarn-debug.*
yarn-error.*


# --- AI assistant / Claude Code ----------------------------------------------
# Local agent configuration and session state. Ignored at any depth, so a
# .claude/ directory added under backend/ or mobile/ is covered without an edit.
#
# WHY THESE ARE NOT WORTH COMMITTING:
#
# .claude/settings.local.json accumulates a permission allowlist as you work, and
# the entries are absolute paths on the machine that produced them — including
# the local Windows username and per-session temp directories. It is useless to a
# teammate and it publishes your directory layout.
#
# CLAUDE.md here is a one-line pointer (`@AGENTS.md`), so ignoring it loses
# nothing: the actual instructions live in AGENTS.md, which stays committed and
# is the vendor-neutral filename other agent tools also read. Keep writing
# guidance there, not in CLAUDE.md.
#
# .mcp.json can carry server URLs and API tokens for connected tools.
.claude/
CLAUDE.md
CLAUDE.local.md
.mcp.json

# Explicitly NOT ignored: AGENTS.md is shared project documentation, and a future
# broad glob should not swallow it.
!AGENTS.md


# --- Editors and OS noise ----------------------------------------------------
.idea/
.vscode/
.fleet/
.nova/
.zed/
.DS_Store
Thumbs.db
desktop.ini


# --- Legacy Laravel tooling --------------------------------------------------
Homestead.json
Homestead.yaml

